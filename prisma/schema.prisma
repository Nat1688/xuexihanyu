// Prisma schema — CLP-00 identity/session + CP-01 Content + CP-03 Learning Events.
//
// SCOPE: the APPROVED tables ONLY:
//   - users                (stable public UUID, normalized unique login, state)   [CLP-00-05]
//   - password_credentials (1:1 user, memory-hard hash + algorithm metadata)       [CLP-00-05]
//   - user_roles           (membership constrained to ADMIN/TEACHER/STUDENT)        [CLP-00-05]
//   - sessions             (opaque server-side session; ADR-003, CLP-00-06)
//   - courses/units/lessons + learning_items + lesson_learning_items              [CP-01]
//   - learning_events      (append-only, versioned interaction evidence)           [CP-03]
//
// CP-01 (accepted) adds teacher-managed curriculum hierarchy and reusable
// Chinese-aware learning items: `courses` -> `units` -> `lessons` (ordered,
// with author/visibility metadata), a reusable `learning_items` library with an
// explicit kind (vocabulary/character/grammar/example/media_reference) and
// Chinese-specific fields (simplified/traditional/pinyin/meaning/HSK/reference),
// plus a `lesson_learning_items` association that orders items within a lesson.
//
// CP-03 (accepted) adds an APPEND-ONLY `learning_events` record: immutable
// interaction evidence (lesson started/completed, exercise presented, answer
// submitted, exercise completed, review activity) with a public UUID, a schema
// version, a typed event vocabulary, server-derived actor/content/exercise
// references, a UTC `occurred_at` instant and BOUNDED, allow-listed metadata.
// There is NO update/delete path (the application repository exposes append
// only) and NO derived progress. Events are EVIDENCE, not mastery.
//
// Still FORBIDDEN here: exercise generators/evaluators (CP-02 — in-memory,
// stateless), mastery/review scheduling/progress projection (CP-04), media
// storage/upload providers, import/export, AI, analytics, public marketplace,
// assignment/enrollment or student progress.
//
// The connection URL is read from the environment variable named by
// `datasource.url`; it is NEVER committed. Development uses `DATABASE_URL`;
// the isolated integration-test database uses `TEST_DATABASE_URL`
// (see scripts/db/*.cjs).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Approved account lifecycle states (subset of ADR-004 used by CP-00).
// ---------------------------------------------------------------------------
enum AccountState {
  PENDING
  ACTIVE
  DISABLED
}

// ---------------------------------------------------------------------------
// Approved role membership values (ADR-004). Exactly three.
// ---------------------------------------------------------------------------
enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

// ---------------------------------------------------------------------------
// users — stable identity record.
//   - `id`         internal surrogate key (never exposed outside persistence).
//   - `publicId`   non-guessable external UUID (the only identifier surfaced).
//   - `login`      raw login identifier as supplied.
//   - `loginNormalized` normalized (trimmed + lower-cased) login, UNIQUE.
//   - `state`      PENDING | ACTIVE | DISABLED.
// ---------------------------------------------------------------------------
model User {
  id              String       @id @default(uuid()) @db.Uuid
  publicId        String       @unique @default(uuid()) @map("public_id") @db.Uuid
  login           String       @db.VarChar(320)
  loginNormalized String       @unique @map("login_normalized") @db.VarChar(320)
  state           AccountState @default(PENDING)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  credential      PasswordCredential?
  roles           UserRoleAssignment[]
  sessions        Session[]
  authoredCourses Course[]
  authoredItems   LearningItem[]
  learningEvents  LearningEvent[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// password_credentials — 1:1 with users. Stores ONLY a memory-hard hash and
// the algorithm metadata needed to verify it. NO plaintext/reversible value.
// ---------------------------------------------------------------------------
model PasswordCredential {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  algorithm         String   @db.VarChar(64)
  parameters        Json
  hash              String   @db.VarChar(512)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

// ---------------------------------------------------------------------------
// user_roles — normalized role membership. Role value constrained to the three
// ADR-004 roles by the enum type + a primary key that prevents duplicates.
// ---------------------------------------------------------------------------
model UserRoleAssignment {
  userId    String   @map("user_id") @db.Uuid
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// sessions — opaque SERVER-SIDE session (ADR-003; CLP-00-06).
//
// The browser holds only an opaque random token in an HttpOnly cookie. The
// token itself is NEVER persisted: only its SHA-256 hash is stored, in
// `token_hash` (UNIQUE), so a database read cannot reconstruct a usable cookie.
// `user_id` is the owning identity; `created_at`/`last_used_at` support
// rotation/observability, `expires_at` bounds lifetime and `revoked_at` marks
// explicit logout/invalidation. No permission/role snapshot is stored — role
// authorization is CLP-00-07 and is always resolved server-side from
// `user_roles`, never from a session copy.
// ---------------------------------------------------------------------------
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  csrfHash   String    @map("csrf_hash") @db.VarChar(128)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ===========================================================================
// CP-01 Content Domain — teacher-managed curriculum hierarchy + reusable
// Chinese-aware learning items. Deterministic read retrieval only; NO exercise
// generation/evaluation, learning events, mastery, media storage, import/export
// or AI.
// ===========================================================================

// ---------------------------------------------------------------------------
// Content visibility (CP-01). `DRAFT` content is authorable but never surfaced
// to students; `PUBLISHED` content is readable by students. Students read only
// according to this value — enforced server-side, never by UI hiding.
// ---------------------------------------------------------------------------
enum ContentVisibility {
  DRAFT
  PUBLISHED
}

// ---------------------------------------------------------------------------
// Reusable learning-item kinds (CP-01). A Chinese learning item is NEVER
// collapsed into a generic term/definition: the kind selects which
// Chinese-specific fields are meaningful (see `LearningItem`).
// ---------------------------------------------------------------------------
enum LearningItemKind {
  VOCABULARY
  CHARACTER
  GRAMMAR
  EXAMPLE
  MEDIA_REFERENCE
}

// ---------------------------------------------------------------------------
// courses — top of the curriculum hierarchy, authored by a TEACHER/ADMIN.
//   - `id`           internal surrogate key (never surfaced).
//   - `publicId`     non-guessable external UUID (the only identifier surfaced).
//   - `slug`         human-readable stable URL key, UNIQUE.
//   - `title`        display title.
//   - `description`  optional long-form description.
//   - `visibility`   DRAFT | PUBLISHED (published gates student reads).
//   - `authorId`     the identity that authored it (server-derived).
//   - `position`     order among courses (ascending, UNIQUE per scope).
// ---------------------------------------------------------------------------
model Course {
  id          String            @id @default(uuid()) @db.Uuid
  publicId    String            @unique @default(uuid()) @map("public_id") @db.Uuid
  slug        String            @unique @db.VarChar(160)
  title       String            @db.VarChar(200)
  description String?           @db.Text
  visibility  ContentVisibility @default(DRAFT)
  authorId    String            @map("author_id") @db.Uuid
  position    Int               @default(0)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  units  Unit[]
  events LearningEvent[]

  @@index([position])
  @@index([visibility])
  @@map("courses")
}

// ---------------------------------------------------------------------------
// units — middle of the hierarchy; belongs to exactly one course. `position`
// is the order WITHIN the parent course (UNIQUE per course), distinct from a
// global order.
// ---------------------------------------------------------------------------
model Unit {
  id          String            @id @default(uuid()) @db.Uuid
  publicId    String            @unique @default(uuid()) @map("public_id") @db.Uuid
  courseId    String            @map("course_id") @db.Uuid
  slug        String            @db.VarChar(160)
  title       String            @db.VarChar(200)
  description String?           @db.Text
  visibility  ContentVisibility @default(DRAFT)
  position    Int               @default(0)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  events  LearningEvent[]

  @@unique([courseId, position])
  @@unique([courseId, slug])
  @@index([courseId])
  @@map("units")
}

// ---------------------------------------------------------------------------
// lessons — bottom of the hierarchy; belongs to exactly one unit. `position`
// is the order WITHIN the parent unit (UNIQUE per unit).
// ---------------------------------------------------------------------------
model Lesson {
  id          String            @id @default(uuid()) @db.Uuid
  publicId    String            @unique @default(uuid()) @map("public_id") @db.Uuid
  unitId      String            @map("unit_id") @db.Uuid
  slug        String            @db.VarChar(160)
  title       String            @db.VarChar(200)
  description String?           @db.Text
  visibility  ContentVisibility @default(DRAFT)
  position    Int               @default(0)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  unit  Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  items LessonLearningItem[]
  events LearningEvent[]

  @@unique([unitId, position])
  @@unique([unitId, slug])
  @@index([unitId])
  @@map("lessons")
}

// ---------------------------------------------------------------------------
// learning_items — reusable, Chinese-aware item library. An item is NOT lesson
// specific and may be associated with many lessons. Chinese-specific fields are
// carried explicitly (`simplified`, `traditional`, `pinyin`, `meaning`) plus
// structured `hskLevel` and a free-form `reference` (JSON) for kind-specific
// structured data. `kind` selects which fields are meaningful; the domain
// contract validates the required fields per kind.
// ---------------------------------------------------------------------------
model LearningItem {
  id          String           @id @default(uuid()) @db.Uuid
  publicId    String           @unique @default(uuid()) @map("public_id") @db.Uuid
  kind        LearningItemKind
  simplified  String?          @db.VarChar(200)
  traditional String?          @db.VarChar(200)
  pinyin      String?          @db.VarChar(200)
  meaning     String?          @db.Text
  hskLevel    Int?             @map("hsk_level")
  reference   Json?
  authorId    String           @map("author_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  author  User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  lessons LessonLearningItem[]
  events  LearningEvent[]

  @@index([kind])
  @@map("learning_items")
}

// ---------------------------------------------------------------------------
// lesson_learning_items — ordered association between a lesson and a reusable
// learning item. `position` orders items WITHIN a lesson (UNIQUE per lesson);
// the same learning item may appear in many lessons.
// ---------------------------------------------------------------------------
model LessonLearningItem {
  lessonId       String   @map("lesson_id") @db.Uuid
  learningItemId String   @map("learning_item_id") @db.Uuid
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  learningItem LearningItem @relation(fields: [learningItemId], references: [id], onDelete: Cascade)

  @@id([lessonId, learningItemId])
  @@unique([lessonId, position])
  @@index([learningItemId])
  @@map("lesson_learning_items")
}

// ---------------------------------------------------------------------------
// Learning event vocabulary (CP-03). The INITIAL, closed set of interaction
// evidence kinds. New event types require a separately approved contract and
// are added here explicitly — there is no free-form/untyped event.
// ---------------------------------------------------------------------------
enum LearningEventType {
  LESSON_STARTED
  LESSON_COMPLETED
  EXERCISE_PRESENTED
  ANSWER_SUBMITTED
  EXERCISE_COMPLETED
  REVIEW_ACTIVITY
}

// ---------------------------------------------------------------------------
// learning_events — APPEND-ONLY interaction evidence (CP-03).
//
// Immutability is a contract, enforced by the application boundary: the
// repository exposes append-only methods and the service has no update/delete
// path. The record is nonetheless a plain relational row (no DB trigger) so it
// stays portable and auditable.
//
//   - `id`             internal surrogate key (never exposed outside persistence).
//   - `publicId`       non-guessable external UUID (the only identifier surfaced).
//   - `schemaVersion`  payload contract version (bounded, validated per type).
//   - `type`           closed LearningEventType vocabulary.
//   - `actorId`        server-derived acting user (FK); never a client claim.
//   - `course/unit/lesson/learningItem` optional content references (FK, nullable)
//                      for the item/lesson the interaction concerns.
//   - `exerciseRef`    optional opaque reference to a CP-02 exercise/instance
//                      (stored as text; CP-02 owns no table).
//   - `occurredAt`     UTC instant the interaction occurred (caller-supplied).
//   - `metadata`       BOUNDED, allow-listed JSON (validated + size-limited in
//                      the domain); NEVER raw answers/secrets/session payloads.
//   - `createdAt`      server receipt time (UTC), the append timestamp.
//
// Ordering is (occurredAt, id) — a stable tiebreak, since two events may share
// an instant.
// ---------------------------------------------------------------------------
model LearningEvent {
  id             String            @id @default(uuid()) @db.Uuid
  publicId       String            @unique @default(uuid()) @map("public_id") @db.Uuid
  schemaVersion  Int               @map("schema_version")
  type           LearningEventType
  actorId        String            @map("actor_id") @db.Uuid
  courseId       String?           @map("course_id") @db.Uuid
  unitId         String?           @map("unit_id") @db.Uuid
  lessonId       String?           @map("lesson_id") @db.Uuid
  learningItemId String?           @map("learning_item_id") @db.Uuid
  exerciseRef    String?           @map("exercise_ref") @db.VarChar(200)
  occurredAt     DateTime          @map("occurred_at") @db.Timestamptz(6)
  metadata       Json?             @map("metadata")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  actor        User          @relation(fields: [actorId], references: [id], onDelete: Restrict)
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  unit         Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  lesson       Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  learningItem LearningItem? @relation(fields: [learningItemId], references: [id], onDelete: SetNull)

  @@index([actorId, occurredAt])
  @@index([occurredAt, id])
  @@index([type])
  @@map("learning_events")
}
