# Chinese Learning Platform — environment variable NAMES only.
# Copy to `.env` and fill real values locally (`.env` is git-ignored).
# Values below are placeholders/harmless examples ONLY — never commit real secrets.
#
# Classification (CLP-00-03 "Configuration boundary"):
#   [server-required]  validated by apps/api/src/config; API fails fast if missing/invalid
#   [server-secret]    server-only; NEVER exposed to the SPA, never logged
#   [spa-public]       the ONLY keys bundled into the browser (must be VITE_-prefixed, non-secret)
#
# Rule: no VITE_ key may carry database/password/session/CSRF/token/secret data.

# --- Runtime [server-required] ---
NODE_ENV=development
API_PORT=3000
SPA_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL / Docker Compose) [server-required; POSTGRES_PASSWORD = server-secret] ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clp_dev
POSTGRES_USER=clp_user
POSTGRES_PASSWORD=

# --- Session / auth (used by later CP-00 tasks) [server-secret] ---
SESSION_SECRET=
SESSION_TTL_MINUTES=60
CSRF_SECRET=

# --- Public SPA (bundled into the browser) [spa-public] ---
# Exposed via apps/web/src/config/public-config.ts allowlist only. Non-secret.
VITE_API_BASE_URL=http://localhost:3000
