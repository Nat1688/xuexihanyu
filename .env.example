# Chinese Learning Platform — environment variable NAMES only.
# Copy to `.env` and fill real values locally (`.env` is git-ignored).
# This CP-00 skeleton does not load production secrets; later tasks own typed config loading.
# Never commit real credentials or secrets.

# --- Runtime ---
NODE_ENV=
API_PORT=
SPA_ORIGIN=

# --- Database (PostgreSQL / Docker Compose) ---
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Session / auth (used by later CP-00 tasks; declared now as names only) ---
SESSION_SECRET=
SESSION_TTL_MINUTES=
CSRF_SECRET=
